<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!--
        This is the PARENT project.
        It doesn't contain code — it just coordinates the 4 child modules.
        Think of it as the project manager that sets rules for everyone under it.
    -->
    <groupId>com.example</groupId>
    <artifactId>kafka-event-platform</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>  <!-- "pom" means this is a parent, not a runnable app -->

    <name>Kafka Event Platform</name>
    <description>Payment processing platform with Kafka event-driven architecture</description>

    <!-- These are the 4 child modules. Maven will build them in this order. -->
    <modules>
        <module>order-service</module>
        <module>payment-service</module>
        <module>inventory-service</module>
        <module>notification-service</module>
    </modules>

    <!--
        The parent POM inherits from Spring Boot's parent.
        This gives us Spring Boot's pre-configured dependency management.
        We don't need to specify versions for most Spring libraries.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <!-- Shared properties — change Java version here to affect all modules -->
    <properties>
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <!--
        dependencyManagement = "catalogue of versions"
        Listing a dependency here does NOT add it to any module.
        It just says: "if any child module wants this library, use THIS version."
        Child modules still have to explicitly ask for each dependency.
    -->
    <dependencyManagement>
        <dependencies>

            <!-- Spring Boot Web: REST controllers, embedded Tomcat -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-starter-web</artifactId>
                <version>3.2.5</version>
            </dependency>

            <!-- Spring Boot Kafka: Kafka producers and consumers -->
            <dependency>
                <groupId>org.springframework.kafka</groupId>
                <artifactId>spring-kafka</artifactId>
                <version>3.1.4</version>
            </dependency>

            <!-- Spring Data JPA: database access via repository pattern -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-starter-data-jpa</artifactId>
                <version>3.2.5</version>
            </dependency>

            <!-- PostgreSQL driver: lets Java talk to Postgres -->
            <dependency>
                <groupId>org.postgresql</groupId>
                <artifactId>postgresql</artifactId>
                <version>42.7.3</version>
            </dependency>

            <!-- Spring Data Redis: connect to Redis for idempotency keys -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-starter-data-redis</artifactId>
                <version>3.2.5</version>
            </dependency>

            <!-- Actuator: health checks and metrics endpoints -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-starter-actuator</artifactId>
                <version>3.2.5</version>
            </dependency>

            <!-- Micrometer Prometheus: exposes metrics in Prometheus format -->
            <dependency>
                <groupId>io.micrometer</groupId>
                <artifactId>micrometer-registry-prometheus</artifactId>
                <version>1.12.5</version>
            </dependency>

            <!-- Lombok: eliminates boilerplate (getters, setters, constructors) -->
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>1.18.32</version>
                <scope>provided</scope> <!-- only needed at compile time -->
            </dependency>

            <!-- Spring Boot Test: JUnit + Mockito for unit tests -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-starter-test</artifactId>
                <version>3.2.5</version>
                <scope>test</scope>
            </dependency>

        </dependencies>
    </dependencyManagement>

    <!-- Build plugins applied to ALL child modules -->
    <build>
        <pluginManagement>
            <plugins>
                <!-- Spring Boot Maven plugin: packages each service as a runnable JAR -->
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <configuration>
                        <!-- Exclude Lombok from the final JAR — not needed at runtime -->
                        <excludes>
                            <exclude>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                            </exclude>
                        </excludes>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

</project>